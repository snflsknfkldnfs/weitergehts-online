2025-12-22T09:08:27.591Z [Filesystem] [info] Message from server: {"result":{"content":[{"type":"text","text":"# weitergehts.online - Environment Variables\n# Kopiere diese Datei nach .env.local und fülle die Werte aus\n\n# =============================================================================\n# ALLGEMEINE KONFIGURATION\n# =============================================================================\n\n# Environment\nNODE_ENV=development\nNEXT_PUBLIC_APP_URL=http://localhost:3000\n\n# =============================================================================\n# DATABASE-KONFIGURATION (PostgreSQL)\n# =============================================================================\n\n# Lokale Entwicklung (Docker)\nDATABASE_URL=\"postgresql://<userinfo>@localhost:5432/weitergehts_dev\"\n\n# Production (wird später konfiguriert)\n# DATABASE_URL=\"postgresql://<userinfo>@hostname:5432/database\"\n\n# =============================================================================\n# AUTHENTICATION (Clerk)\n# =============================================================================\n\n# Clerk Keys (von https://clerk.dev/)\nNEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...\nCLERK_SECRET_KEY=sk_test_...\n\n# Clerk Konfiguration\nNEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in\nNEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up\nNEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard\nNEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding\n\n# =============================================================================\n# KI-INTEGRATION\n# =============================================================================\n\n# OpenAI API (für PATA-System)\nOPENAI_API_KEY=sk-...\nOPENAI_MODEL=gpt-4-turbo-preview\n\n# Anthropic Claude API (Backup/Alternative)\nANTHROPIC_API_KEY=sk-ant-...\nANTHROPIC_MODEL=claude-3-sonnet-20240229\n\n# AI Provider Selection\nAI_PROVIDER=openai\n# Optionen: \"openai\" oder \"anthropic\"\n\n# =============================================================================\n# PATA-SYSTEM KONFIGURATION\n# =============================================================================\n\n# PATA-1: Quality Gate\nPATA1_QUALITY_THRESHOLD=0.85\nPATA1_MAX_RETRIES=3\nPATA1_TIMEOUT_MS=5000\n\n# PATA-2: Learning Engine\nPATA2_LEARNING_RATE=0.1\nPATA2_BATCH_SIZE=100\nPATA2_LEARNING_INTERVAL_HOURS=24\n\n# PATA-3: System Monitor\nPATA3_HEALTH_CHECK_INTERVAL_MINUTES=15\nPATA3_ALERT_THRESHOLD_ERROR_RATE=0.05\nPATA3_ALERT_THRESHOLD_RESPONSE_TIME_MS=8000\n\n# =============================================================================\n# PERFORMANCE & LIMITS\n# =============================================================================\n\n# Token-Management\nMAX_CONTEXT_TOKENS=4600\nMAX_REQUEST_TOKENS=8000\nTOKEN_BUFFER_SIZE=200\n\n# Rate Limiting\nRATE_LIMIT_REQUESTS_PER_MINUTE=60\nRATE_LIMIT_REQUESTS_PER_HOUR=1000\n\n# Request Timeouts\nREQUEST_TIMEOUT_SECONDS=30\nAI_REQUEST_TIMEOUT_SECONDS=45\n\n# =============================================================================\n# MONITORING & LOGGING\n# =============================================================================\n\n# Logging-Level\nLOG_LEVEL=info\n# Optionen: \"error\", \"warn\", \"info\", \"debug\"\n\n# Analytics (optional)\n# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-...\n# NEXT_PUBLIC_POSTHOG_KEY=...\n\n# Error Tracking (optional)\n# SENTRY_DSN=https://...\n# SENTRY_ORG=weitergehts-online\n# SENTRY_PROJECT=frontend\n\n# =============================================================================\n# DSGVO & PRIVACY\n# =============================================================================\n\n# Privacy-Einstellungen\nENABLE_ANALYTICS=false\nENABLE_ERROR_TRACKING=false\nENABLE_CROSS_INSTANCE_LEARNING=true\n\n# Cookie-Konfiguration\nCOOKIE_SECURE=true\nCOOKIE_SAME_SITE=strict\nCOOKIE_MAX_AGE_SECONDS=604800\n\n# Daten-Retention (in Tagen)\nUSER_DATA_RETENTION_DAYS=365\nCONVERSATION_DATA_RETENTION_DAYS=90\nLEARNING_DATA_RETENTION_DAYS=730\n\n# =============================================================================\n# ENTWICKLUNG & TESTING\n# =============================================================================\n\n# Development-Tools\nNEXT_PUBLIC_ENABLE_DEVTOOLS=true\nENABLE_API_DOCS=true\nENABLE_DEBUG_LOGS=true\n\n# Testing\nTEST_DATABASE_URL=\"postgresql://<userinfo>@localhost:5433/weitergehts_test\"\nPLAYWRIGHT_BASE_URL=http://localhost:3000\n\n# =============================================================================\n# DEPLOYMENT & PRODUCTION\n# =============================================================================\n\n# Production-spezifische Einstellungen (wird später konfiguriert)\n# DEPLOYMENT_ENVIRONMENT=production\n# CDN_URL=https://cdn.weitergehts.online\n# REDIS_URL=redis://...\n\n# Health-Check-Endpoints\nHEALTH_CHECK_ENABLED=true\nHEALTH_CHECK_SECRET=your-secret-key-here\n\n# =============================================================================\n# FEATURE-FLAGS\n# =============================================================================\n\n# Experimentelle Features\nFEATURE_VOICE_INPUT=false\nFEATURE_ADVANCED_PERSONALIZATION=true\nFEATURE_BETA_PATA_SYSTEM=true\nFEATURE_MOBILE_APP_INTEGRATION=false\n\n# UI/UX Features\nFEATURE_DARK_MODE=true\nFEATURE_ACCESSIBILITY_ENHANCED=true\nFEATURE_MOBILE_RESPONSIVE=true\n\n# =============================================================================\n# INTEGRATION MIT BESTEHENDEN SYSTEMEN\n# =============================================================================\n\n# Kanban-Board Integration (optional)\nKANBAN_INTEGRATION_ENABLED=false\n# KANBAN_API_URL=...\n# KANBAN_API_KEY=...\n\n# MCP-Server Integration (optional)\nMCP_SERVER_INTEGRATION_ENABLED=false\n# MCP_SERVER_URL=...\n# MCP_SERVER_AUTH_TOKEN=...\n\n# =============================================================================\n# SICHERHEIT\n# =============================================================================\n\n# Encryption\nENCRYPTION_KEY=your-32-character-secret-key-here\nJWT_SECRET=your-jwt-secret-key-here\n\n# CORS\nCORS_ORIGIN=http://localhost:3000\n# Production: CORS_ORIGIN=https://weitergehts.online\n\n# CSP-Headers\nCSP_ENABLED=true\n\n# =============================================================================\n# BACKUP & RECOVERY\n# =============================================================================\n\n# Automatische Backups (Production)\n# BACKUP_ENABLED=false\n# BACKUP_SCHEDULE_CRON=\"0 2 * * *\"\n# BACKUP_RETENTION_DAYS=30\n# BACKUP_STORAGE_URL=...\n\n# =============================================================================\n# HINWEISE FÜR ENTWICKLER\n# =============================================================================\n\n# 1. Niemals .env.local in Git committen!\n# 2. Für lokale Entwicklung: kopiere diese Datei nach .env.local\n# 3. Für Production: setze Environment-Variablen über Deployment-Platform\n# 4. Alle Secrets über sichere Kanäle austauschen\n# 5. Regelmäßig API-Keys rotieren\n\n# =============================================================================\n# TEAM-SPEZIFISCHE KONFIGURATION\n# =============================================================================\n\n# Entwickler-spezifische Einstellungen\nDEVELOPER_MODE=true\nENABLE_HOT_RELOAD=true\nENABLE_TYPE_CHECKING=true\nENABLE_LINTING=true\n\n# Team-Koordination\nTEAM_CHAT_WEBHOOK_URL=\nDEPLOYMENT_NOTIFICATION_WEBHOOK=\n\n# Code-Quality\nENABLE_PRETTIER=true\nENABLE_ESLINT=true\nENABLE_TYPESCRIPT_STRICT=true\n"}]},"jsonrpc":"2.0","id":19} { metadata: undefined }
