2025-12-22T09:07:25.570Z [Filesystem] [info] Message from server: {"result":{"content":[{"type":"text","text":"# weitergehts.online - Docker Compose für lokale Entwicklung\n# Für Team-Konsistenz und einfaches Setup\n\nversion: '3.8'\n\nservices:\n  # =============================================================================\n  # HAUPTANWENDUNG (NextJS Development Server)\n  # =============================================================================\n  app:\n    build:\n      context: .\n      dockerfile: docker/Dockerfile.dev\n    container_name: weitergehts-app-dev\n    ports:\n      - \"3000:3000\"\n    volumes:\n      # Source-Code-Mounting für Hot-Reload\n      - .:/app\n      - /app/node_modules\n      - /app/.next\n    environment:\n      - NODE_ENV=development\n      - NEXT_PUBLIC_APP_URL=http://localhost:3000\n      - DATABASE_URL=postgresql://<userinfo>@db:5432/weitergehts_dev\n      - REDIS_URL=redis://redis:6379\n    depends_on:\n      - db\n      - redis\n    networks:\n      - weitergehts-network\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD\", \"curl\", \"-f\", \"http://localhost:3000/api/health\"]\n      interval: 30s\n      timeout: 10s\n      retries: 3\n\n  # =============================================================================\n  # POSTGRESQL DATABASE\n  # =============================================================================\n  db:\n    image: postgres:15-alpine\n    container_name: weitergehts-db-dev\n    environment:\n      POSTGRES_DB: weitergehts_dev\n      POSTGRES_USER: weitergehts_user\n      POSTGRES_PASSWORD: dev_password\n      POSTGRES_INITDB_ARGS: \"--encoding=UTF8 --locale=C\"\n    ports:\n      - \"5432:5432\"\n    volumes:\n      # Persistente Datenbank-Daten\n      - postgres_data:/var/lib/postgresql/data\n      # Initialization-Scripts\n      - ./docker/postgres-init:/docker-entrypoint-initdb.d/\n    networks:\n      - weitergehts-network\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U weitergehts_user -d weitergehts_dev\"]\n      interval: 10s\n      timeout: 5s\n      retries: 5\n\n  # =============================================================================\n  # REDIS (für Caching & Session-Management)\n  # =============================================================================\n  redis:\n    image: redis:7-alpine\n    container_name: weitergehts-redis-dev\n    ports:\n      - \"6379:6379\"\n    volumes:\n      - redis_data:/data\n      - ./docker/redis.conf:/usr/local/etc/redis/redis.conf\n    command: redis-server /usr/local/etc/redis/redis.conf\n    networks:\n      - weitergehts-network\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD\", \"redis-cli\", \"ping\"]\n      interval: 10s\n      timeout: 5s\n      retries: 3\n\n  # =============================================================================\n  # ADMINER (Database-Management UI)\n  # =============================================================================\n  adminer:\n    image: adminer:latest\n    container_name: weitergehts-adminer-dev\n    ports:\n      - \"8080:8080\"\n    environment:\n      ADMINER_DEFAULT_SERVER: db\n      ADMINER_DESIGN: pappu687\n    networks:\n      - weitergehts-network\n    restart: unless-stopped\n    profiles:\n      - tools # Nur starten mit: docker-compose --profile tools up\n\n  # =============================================================================\n  # MAILHOG (Email-Testing für lokale Entwicklung)\n  # =============================================================================\n  mailhog:\n    image: mailhog/mailhog:latest\n    container_name: weitergehts-mailhog-dev\n    ports:\n      - \"1025:1025\" # SMTP-Server\n      - \"8025:8025\" # Web-UI\n    networks:\n      - weitergehts-network\n    restart: unless-stopped\n    profiles:\n      - tools\n\n  # =============================================================================\n  # NGINX (für lokale SSL & Reverse-Proxy-Tests)\n  # =============================================================================\n  nginx:\n    image: nginx:alpine\n    container_name: weitergehts-nginx-dev\n    ports:\n      - \"80:80\"\n      - \"443:443\"\n    volumes:\n      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf\n      - ./docker/nginx/ssl:/etc/nginx/ssl\n    depends_on:\n      - app\n    networks:\n      - weitergehts-network\n    restart: unless-stopped\n    profiles:\n      - ssl # Nur für SSL-Testing\n\n# =============================================================================\n# VOLUMES (Persistente Daten)\n# =============================================================================\nvolumes:\n  postgres_data:\n    driver: local\n    name: weitergehts_postgres_data\n  redis_data:\n    driver: local\n    name: weitergehts_redis_data\n  node_modules:\n    driver: local\n    name: weitergehts_node_modules\n\n# =============================================================================\n# NETWORKS\n# =============================================================================\nnetworks:\n  weitergehts-network:\n    driver: bridge\n    name: weitergehts-network\n\n# =============================================================================\n# TEAM-DEVELOPMENT-BEFEHLE\n# =============================================================================\n\n# Grundsetup (Standard-Entwicklung):\n# docker-compose up -d\n\n# Mit Tools (Adminer, MailHog):\n# docker-compose --profile tools up -d\n\n# Mit SSL-Testing:\n# docker-compose --profile ssl up -d\n\n# Nur Datenbank & Redis:\n# docker-compose up -d db redis\n\n# Logs anzeigen:\n# docker-compose logs -f app\n\n# Database-Shell:\n# docker-compose exec db psql -U weitergehts_user -d weitergehts_dev\n\n# Redis-CLI:\n# docker-compose exec redis redis-cli\n\n# App-Container-Shell:\n# docker-compose exec app sh\n\n# Komplett neu aufbauen:\n# docker-compose down -v && docker-compose build --no-cache && docker-compose up -d\n\n# =============================================================================\n# DATENBANK-SETUP FÜR NEUES TEAM-MITGLIED\n# =============================================================================\n\n# 1. Container starten:\n#    docker-compose up -d db\n\n# 2. Prisma-Schema generieren:\n#    npm run db:generate\n\n# 3. Migrationen ausführen:\n#    npm run db:migrate\n\n# 4. Test-Daten laden:\n#    npm run db:seed\n\n# =============================================================================\n# PERFORMANCE-OPTIMIERUNGEN\n# =============================================================================\n\n# Für Apple Silicon (M1/M2) Macs:\n# - postgres:15-alpine hat native ARM64-Support\n# - redis:7-alpine optimiert für ARM64\n# - node:18-alpine mit nativer Performance\n\n# Memory-Limits für Entwicklung:\n# Kann bei Bedarf aktiviert werden:\n# mem_limit: 1g\n# memswap_limit: 1g\n\n# =============================================================================\n# MONITORING & DEBUGGING\n# =============================================================================\n# Alle Services haben Healthchecks definiert\n# Status prüfen mit: docker-compose ps\n# Logs mit: docker-compose logs -f [service]\n\n# =============================================================================\n# PRODUCTION-HINWEISE\n# =============================================================================\n# Diese docker-compose.yml ist NUR für Entwicklung!\n# Für Production separate docker-compose.prod.yml verwenden\n# Niemals development-Passwörter in Production verwenden!\n"}]},"jsonrpc":"2.0","id":17} { metadata: undefined }
