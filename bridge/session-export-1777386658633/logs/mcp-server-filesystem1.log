2025-12-23T08:38:06.309Z [Filesystem] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"content":"#!/usr/bin/env python3\n\"\"\"\nMarkdown to Word Converter for WiB TUVs\nConverts TUV Markdown files to professionally formatted Word documents.\n\nUsage:\n    python3 md_to_word.py <input.md> <output.docx>\n    \nRequirements:\n    pip install python-docx --break-system-packages\n\"\"\"\n\nimport sys\nimport re\nfrom pathlib import Path\nfrom docx import Document\nfrom docx.shared import Pt, Inches, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.style import WD_STYLE_TYPE\n\ndef setup_styles(doc):\n    \"\"\"Configure document styles for TUV standard.\"\"\"\n    # Get or create styles\n    styles = doc.styles\n    \n    # Heading 1 - Main sections\n    try:\n        h1 = styles['Heading 1']\n    except KeyError:\n        h1 = styles.add_style('Heading 1', WD_STYLE_TYPE.PARAGRAPH)\n    h1.font.size = Pt(14)\n    h1.font.bold = True\n    h1.font.color.rgb = RGBColor(0, 0, 0)\n    \n    # Heading 2 - Subsections\n    try:\n        h2 = styles['Heading 2']\n    except KeyError:\n        h2 = styles.add_style('Heading 2', WD_STYLE_TYPE.PARAGRAPH)\n    h2.font.size = Pt(12)\n    h2.font.bold = True\n    h2.font.color.rgb = RGBColor(0, 0, 0)\n    \n    # Heading 3 - Sub-subsections\n    try:\n        h3 = styles['Heading 3']\n    except KeyError:\n        h3 = styles.add_style('Heading 3', WD_STYLE_TYPE.PARAGRAPH)\n    h3.font.size = Pt(11)\n    h3.font.bold = True\n    h3.font.color.rgb = RGBColor(0, 0, 0)\n\ndef parse_markdown_table(lines):\n    \"\"\"Parse markdown table into structured data.\"\"\"\n    if len(lines) < 2:\n        return None\n    \n    # Parse header\n    header_line = lines[0]\n    headers = [cell.strip() for cell in header_line.split('|')[1:-1]]\n    \n    # Parse rows (skip separator line at index 1)\n    rows = []\n    for line in lines[2:]:\n        cells = [cell.strip() for cell in line.split('|')[1:-1]]\n        if cells and any(cells):  # Skip empty rows\n            rows.append(cells)\n    \n    return {'headers': headers, 'rows': rows}\n\ndef add_table_to_doc(doc, table_data):\n    \"\"\"Add formatted table to Word document.\"\"\"\n    if not table_data:\n        return\n    \n    headers = table_data['headers']\n    rows = table_data['rows']\n    \n    # Create table\n    table = doc.add_table(rows=len(rows) + 1, cols=len(headers))\n    table.style = 'Light Grid Accent 1'\n    \n    # Add headers\n    for i, header in enumerate(headers):\n        cell = table.rows[0].cells[i]\n        cell.text = header\n        # Bold header\n        for paragraph in cell.paragraphs:\n            for run in paragraph.runs:\n                run.bold = True\n    \n    # Add data rows\n    for row_idx, row_data in enumerate(rows, start=1):\n        for col_idx, cell_data in enumerate(row_data):\n            if col_idx < len(table.rows[row_idx].cells):\n                table.rows[row_idx].cells[col_idx].text = cell_data\n\ndef convert_markdown_to_word(md_path, docx_path):\n    \"\"\"\n    Convert Markdown TUV to Word document.\n    \n    Args:\n        md_path: Path to input Markdown file\n        docx_path: Path to output Word file\n    \"\"\"\n    # Read markdown\n    with open(md_path, 'r', encoding='utf-8') as <drv>:\n        lines = f.readlines()\n    \n    # Create document\n    doc = Document()\n    setup_styles(doc)\n    \n    # State tracking\n    in_table = False\n    table_lines = []\n    list_type = None  # 'numbered' or 'bullet'\n    \n    i = 0\n    while i < len(lines):\n        line = lines[i].rstrip()\n        \n        # Skip empty lines (but add paragraph break if not first line)\n        if not line.strip():\n            if i > 0 and not in_table:\n                doc.add_paragraph()\n            i += 1\n            continue\n        \n        # H1 Heading (Title)\n        if line.startswith('# '):\n            title = line[2:].strip()\n            heading = doc.add_heading(title, level=0)\n            heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n            i += 1\n            continue\n        \n        # H2 Heading (Main sections)\n        if line.startswith('## '):\n            heading_text = line[3:].strip()\n            doc.add_heading(heading_text, level=1)\n            i += 1\n            continue\n        \n        # H3 Heading (Subsections)\n        if line.startswith('### '):\n            heading_text = line[4:].strip()\n            doc.add_heading(heading_text, level=2)\n            i += 1\n            continue\n        \n        # Table detection\n        if '|' in line and not in_table:\n            # Start collecting table lines\n            in_table = True\n            table_lines = [line]\n            i += 1\n            continue\n        \n        if in_table:\n            if '|' in line:\n                table_lines.append(line)\n                i += 1\n                continue\n            else:\n                # End of table\n                table_data = parse_markdown_table(table_lines)\n                add_table_to_doc(doc, table_data)\n                in_table = False\n                table_lines = []\n                # Don't increment i, process current line\n                continue\n        \n        # Numbered list\n        if re.match(r'^\\d+\\.<unc>            text = re.sub(r'^\\d+\\.<unc>            doc.add_paragraph(text, style='List Number')\n            list_type = 'numbered'\n            i += 1\n            continue\n        \n        # Bullet list\n        if line.startswith('- ') or line.startswith('* '):\n            text = line[2:].strip()\n            doc.add_paragraph(text, style='List Bullet')\n            list_type = 'bullet'\n            i += 1\n            continue\n        \n        # Bold text (basic support)\n        if '**' in line:\n            p = doc.add_paragraph()\n            parts = line.split('**')\n            for idx, part in enumerate(parts):\n                if idx % 2 == 0:\n                    p.add_run(part)\n                else:\n                    p.add_run(part).bold = True\n            i += 1\n            continue\n        \n        # Normal paragraph\n        doc.add_paragraph(line)\n        list_type = None\n        i += 1\n    \n    # Handle trailing table\n    if in_table and table_lines:\n        table_data = parse_markdown_table(table_lines)\n        add_table_to_doc(doc, table_data)\n    \n    # Save document\n    doc.save(docx_path)\n    return docx_path\n\ndef main():\n    \"\"\"CLI entry point.\"\"\"\n    if len(sys.argv) != 3:\n        print(\"Usage: python3 md_to_word.py <input.md> <output.docx>\")\n        print(\"\\nExample:\")\n        print(\"  python3 md_to_word.py tuv.md tuv.docx\")\n        sys.exit(1)\n    \n    md_path = Path(sys.argv[1])\n    docx_path = Path(sys.argv[2])\n    \n    if not md_path.exists():\n        print(f\"Error: Input file not found: {md_path}\")\n        sys.exit(1)\n    \n    try:\n        output = convert_markdown_to_word(str(md_path), str(docx_path))\n        print(f\"✅ Success: Word document created\")\n        print(f\"📄 Output: {output}\")\n        print(f\"📊 Size: {docx_path.stat().st_size:,} bytes\")\n    except Exception as <drv>:\n        print(f\"❌ Error: {e}\")\n        import traceback\n        traceback.print_exc()\n        sys.exit(1)\n\nif __name__ == '__main__':\n    main()\n","path":"~/weitergehts.online/scripts/converters/md_to_word.py"}},"jsonrpc":"2.0","id":49} { metadata: undefined }
