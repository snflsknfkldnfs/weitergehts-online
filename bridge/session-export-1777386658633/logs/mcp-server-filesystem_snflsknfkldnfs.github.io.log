ont-size: 12px;\n            border-top-left-radius: 8px;\n        }\n        \n        .case-content {\n            padding: 20px;\n        }\n        \n        .about-amara {\n            background-color: #FFF3E0;\n            border-radius: 10px;\n            padding: 15px;\n            margin-bottom: 20px;\n            border-left: 5px solid #FF9800;\n        }\n        \n        .section-title {\n            color: #FF6B6B;\n            font-weight: bold;\n            font-size: 18px;\n            margin-bottom: 10px;\n            display: flex;\n            align-items: center;\n        }\n        \n        .section-title::before {\n            content: \"👧\";\n            margin-right: 10px;\n        }\n        \n        .facts-title {\n            background-color: #FF6B6B;\n            color: white;\n            padding: 8px 15px;\n            border-radius: 20px;\n            font-size: 16px;\n            font-weight: bold;\n            display: inline-block;\n            margin-bottom: 15px;\n        }\n        \n        .facts-container {\n            background-color: #f9f9f9;\n            border-radius: 10px;\n            padding: 15px;\n            margin-bottom: 20px;\n        }\n        \n        .facts-list {\n            list-style-type: none;\n            padding: 0;\n            margin: 0;\n        }\n        \n        .facts-list li {\n            padding: 8px 0 8px 35px;\n            position: relative;\n            border-bottom: 1px dashed #ddd;\n        }\n        \n        .facts-list li:last-child {\n            border-bottom: none;\n        }\n        \n        .facts-list li::before {\n            content: \"✓\";\n            position: absolute;\n            left: 10px;\n            color: #FF6B6B;\n            font-weight: bold;\n        }\n        \n        .mission-box {\n            background-color: #E3F2FD;\n            border: 2px dashed #2196F3;\n            border-radius: 10px;\n            padding: 15px;\n            margin-top: 20px;\n            text-align: center;\n        }\n        \n        .mission-title {\n            color: #2196F3;\n            font-weight: bold;\n            margin-bottom: 10px;\n            font-size: 18px;\n        }\n        \n        .note {\n            font-style: italic;\n            color: #666;\n            font-size: 14px;\n            margin-top: 20px;\n            text-align: center;\n        }\n        \n        .badge {\n            position: absolute;\n            top: -10px;\n            right: -10px;\n            background-color: #FFD600;\n            color: #333;\n            border-radius: 50%;\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: bold;\n            transform: rotate(15deg);\n            box-shadow: 0 2px 5px rgba(0,0,0,0.2);\n            font-size: 14px;\n            text-align: center;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"case-card\">\n        <div class=\"case-header\">\n            <h1 class=\"case-title\">Amara aus Indien</h1>\n            <p class=\"case-subtitle\">Eine Kinderarbeiterin in der Textilindustrie</p>\n            <div class=\"badge\">12 Jahre alt</div>\n        </div>\n        \n        <div class=\"case-image\">\n            <div class=\"image-caption\">Symbolbild: Eine Textilfabrik in Indien</div>\n        </div>\n        \n        <div class=\"case-content\">\n            <div class=\"about-amara\">\n                <div class=\"section-title\">Über Amara</div>\n                <p>Amara ist 12 Jahre alt und lebt mit ihrer Familie in einem kleinen Dorf in Indien. Sie arbeitet in einer Textilfabrik, wo sie Kleidung näht, die nach Deutschland und in andere europäische Länder verkauft wird.</p>\n            </div>\n            \n            <div class=\"facts-title\">FAKTEN zum Fall</div>\n            \n            <div class=\"facts-container\">\n                <ul class=\"facts-list\">\n                    <li>Sie arbeitet 10 Stunden am Tag, 6 Tage pro Woche</li>\n                    <li>Sie verdient umgerechnet 0,50 € pro Stunde</li>\n                    <li>Sie kann nicht zur Schule gehen</li>\n                    <li>In der Fabrik ist es laut und staubig</li>\n                    <li>Sie muss oft mit gefährlichen Maschinen arbeiten</li>\n                    <li>Amara arbeitet, damit ihre Familie genug zu essen hat</li>\n                </ul>\n            </div>\n            \n            <div class=\"mission-box\">\n                <div class=\"mission-title\">Deine Detektiv-Mission</div>\n                <p>Untersuche den Fall mit dem Kinderrechts-Check: Werden Amaras Rechte verletzt? Wenn ja, welche und warum?</p>\n            </div>\n            \n            <p class=\"note\">Hinweis: Dies ist ein vereinfachtes Fallbeispiel für Unterrichtszwecke.</p>\n        </div>\n    </div>\n</body>\n</html>\n"}]}}
