2025-05-11T14:41:02.594Z [filesystem_snflsknfkldnfs.github.io] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"path":"~/snflsknfkldnfs.github.io/tools/artefaktcraft/config/config.yaml","content":"\n# ArtefaktCraft Konfiguration\n# Version 1.0.0\n\n# OpenAI API-Konfiguration\nopenai:\n  api_key: ${OPENAI_API_KEY}  # Aus Umgebungsvariable\n  model: \"gpt-4\"\n  temperature: 0.7\n  max_tokens: 4000\n\n# Repository-Konfiguration\nrepository:\n  base_path: \"~/snflsknfkldnfs.github.io\"\n  template_path: \"~/snflsknfkldnfs.github.io/tools/artefaktcraft/templates\"\n  output_paths:\n    wib: \"~/snflsknfkldnfs.github.io/notizen/wib\"\n    gpg: \"~/snflsknfkldnfs.github.io/notizen/gpg\"\n    methodik: \"~/snflsknfkldnfs.github.io/notizen/methodik\"\n    leitfaden: \"~/snflsknfkldnfs.github.io/notizen/leitfaden\"\n\n# Artefakt-Typen\nartefakt_types:\n  - id: \"sequenzplanung\"\n    name: \"Sequenzplanung\"\n    template: \"sequenzplanung_template.md\"\n    output_dir: \"${fach}/sequenzplanung\"\n    dialog_flow: \"sequenzplanung_dialog.yaml\"\n    metadata_schema:\n      - name: \"title\"\n        type: \"string\"\n        required: true\n        prompt: \"Titel der Sequenzplanung\"\n      - name: \"fach\"\n        type: \"enum\"\n        options: [\"WiB\", \"GPG\"]\n        required: true\n        prompt: \"Für welches Fach ist die Sequenzplanung?\"\n      - name: \"jahrgangsstufe\"\n        type: \"enum\"\n        options: [\"5\", \"6\", \"7\", \"8\", \"9\", \"10\"]\n        required: true\n        prompt: \"Für welche Jahrgangsstufe ist die Sequenzplanung?\"\n      - name: \"umfang\"\n        type: \"number\"\n        required: true\n        prompt: \"Wie viele Unterrichtsstunden umfasst die Sequenz?\"\n      - name: \"zeitraum\"\n        type: \"string\"\n        required: false\n        prompt: \"In welchem Zeitraum soll die Sequenz stattfinden?\"\n      \n  - id: \"unterrichtseinheit\"\n    name: \"Unterrichtseinheit\"\n    template: \"unterrichtseinheit_template.md\"\n    output_dir: \"${fach}/unterrichtseinheiten\"\n    dialog_flow: \"unterrichtseinheit_dialog.yaml\"\n    metadata_schema:\n      - name: \"title\"\n        type: \"string\"\n        required: true\n        prompt: \"Titel der Unterrichtseinheit\"\n      - name: \"fach\"\n        type: \"enum\"\n        options: [\"WiB\", \"GPG\"]\n        required: true\n        prompt: \"Für welches Fach ist die Unterrichtseinheit?\"\n      - name: \"jahrgangsstufe\"\n        type: \"enum\"\n        options: [\"5\", \"6\", \"7\", \"8\", \"9\", \"10\"]\n        required: true\n        prompt: \"Für welche Jahrgangsstufe ist die Unterrichtseinheit?\"\n      - name: \"dauer\"\n        type: \"number\"\n        required: true\n        prompt: \"Wie viele Unterrichtsstunden umfasst die Einheit?\"\n      - name: \"lernbereich\"\n        type: \"string\"\n        required: true\n        prompt: \"Auf welchen Lernbereich bezieht sich die Unterrichtseinheit?\"\n\n# Benutzeroberflächen-Konfiguration\nui:\n  web_interface:\n    port: 8080\n    host: \"<ip>\"\n    templates_dir: \"~/snflsknfkldnfs.github.io/tools/artefaktcraft/src/web/templates\"\n    static_dir: \"~/snflsknfkldnfs.github.io/tools/artefaktcraft/src/web/static\"\n  cli:\n    prompt_color: \"green\"\n    response_color: \"blue\"\n    error_color: \"red\"\n\n# Logging-Konfiguration\nlogging:\n  level: \"INFO\"\n  file: \"~/snflsknfkldnfs.github.io/tools/artefaktcraft/logs/artefaktcraft.log\"\n  format: \"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n  max_size: 10485760  # 10 MB\n  backup_count: 5\n\n# Integration mit bestehenden Systemen\nintegration:\n  git:\n    enabled: true\n    commit_message_template: \"ArtefaktCraft: Erstelle {artefakt_type} '{title}'\"\n    auto_commit: false\n  mcp_server:\n    enabled: false\n    url: \"http://localhost:9000\"\n    auth_token: \"\"\n"}},"jsonrpc":"2.0","id":44}
