when you need to understand PDF contents beyond just form fields.","inputSchema":{"type":"object","properties":{"pdf_path":{"type":"string","description":"Path to the PDF file"}},"required":["pdf_path"]}},{"name":"get_pdf_resource_uri","description":"Get a resource URI for a PDF file that can be used with Claude's built-in PDF reading capabilities via the Resources API","inputSchema":{"type":"object","properties":{"pdf_path":{"type":"string","description":"Path to the PDF file"}},"required":["pdf_path"]}}]},"jsonrpc":"2.0","id":1}
