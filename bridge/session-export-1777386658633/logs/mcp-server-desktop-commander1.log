2025-10-21T14:29:41.118Z [desktop-commander] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"path":"~/weitergehts.online/Unterricht/GPG/GPG7c/01_Absolutismus/GPG7c-LB2-09-Vergleich Revolution Frankreich Ägypten/AB_1a_Fatima_Interview_Aegypten_2011.html","content":"<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>AB 1a: Interview mit Fatima - Ägypten 2011</title>\n    <style>\n        /* Print-optimiertes CSS für A4-Format */\n        @page {\n            size: A4;\n            margin: 2cm;\n        }\n        \n        @media print {\n            body {\n                margin: 0;\n                padding: 0;\n            }\n            .no-print {\n                display: none;\n            }\n        }\n        \n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: Arial, sans-serif;\n            font-size: 11pt;\n            line-height: 1.4;\n            color: #000;\n            background: #fff;\n            width: 21cm;\n            margin: 0 auto;\n            padding: 2cm;\n        }\n        \n        /* Header-Tabelle */\n        .header-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 1.5em;\n        }\n        \n        .header-table td {\n            border: 1px solid #000;\n            padding: 0.3cm;\n            height: 1cm;\n        }\n        \n        .header-table td:nth-child(1),\n        .header-table td:nth-child(3) {\n            width: 15%;\n            font-weight: normal;\n        }\n        \n        .header-table td:nth-child(2),\n        .header-table td:nth-child(4) {\n            width: 35%;\n        }\n        \n        /* Titel */\n        .title {\n            font-size: 14pt;\n            font-weight: bold;\n            margin-bottom: 0.3em;\n        }\n        \n        .subtitle {\n            font-size: 9pt;\n            color: #333;\n            margin-bottom: 1.5em;\n        }\n        \n        /* Arbeitsanweisung */\n        .instruction {\n            font-weight: bold;\n            margin-bottom: 1em;\n        }\n        \n        /* Interview-Box */\n        .interview-box {\n            border: 2px solid #000;\n            padding: 0.8cm;\n            margin-bottom: 1.5em;\n            background: #f9f9f9;\n        }\n        \n        .interview-box p {\n            margin-bottom: 0.5em;\n        }\n        \n        .interview-box p:last-child {\n            margin-bottom: 0;\n        }\n        \n        .interview-box strong {\n            font-weight: bold;\n        }\n        \n        /* Aufgaben */\n        .tasks {\n            margin-top: 1.5em;\n        }\n        \n        .task {\n            margin-bottom: 2em;\n        }\n        \n        .task-title {\n            font-weight: bold;\n            margin-bottom: 0.5em;\n        }\n        \n        .answer-line {\n            border-bottom: 1px solid #000;\n            height: 1.2cm;\n            margin-bottom: 0.5em;\n        }\n        \n        .answer-line-short {\n            border-bottom: 1px solid #000;\n            height: 0.8cm;\n            margin-bottom: 0.3em;\n        }\n        \n        /* Checkbox-Aufgabe */\n        .checkbox-options {\n            display: flex;\n            gap: 2cm;\n            margin-top: 0.5em;\n        }\n        \n        .checkbox-option {\n            display: flex;\n            align-items: center;\n            gap: 0.3cm;\n        }\n        \n        .checkbox {\n            width: 0.5cm;\n            height: 0.5cm;\n            border: 1px solid #000;\n            display: inline-block;\n        }\n        \n        /* Button für Browser-Ansicht */\n        .no-print {\n            position: fixed;\n            top: 1cm;\n            right: 1cm;\n            background: #007bff;\n            color: white;\n            padding: 10px 20px;\n            border: none;\n            border-radius: 5px;\n            cursor: pointer;\n            font-size: 14px;\n            box-shadow: 0 2px 5px rgba(0,0,0,0.2);\n        }\n        \n        .no-print:hover {\n            background: #0056b3;\n        }\n    </style>\n</head>\n<body>\n    <!-- Druck-Button (nur in Browser-Ansicht) -->\n    <button class=\"no-print\" onclick=\"window.print()\">🖨️ Drucken / Als PDF speichern</button>\n    \n    <!-- Header mit Name/Datum -->\n    <table class=\"header-table\">\n        <tr>\n            <td>Name:</td>\n            <td></td>\n            <td>Datum:</td>\n            <td></td>\n        </tr>\n    </table>\n    \n    <!-- Titel -->\n    <div class=\"title\">Interview mit Fatima – Ägypten 2011</div>\n    <div class=\"subtitle\">Fach: GPG, Thema: Arabischer Frühling / Revolution in Ägypten</div>\n    \n    <!-- Arbeitsanweisung -->\n    <div class=\"instruction\">Lies das Interview aufmerksam durch und beantworte die Fragen unten.</div>\n    \n    <!-- Interview-Box -->\n    <div class=\"interview-box\">\n        <p><strong>Mein Name ist Fatima. Ich bin 23 Jahre alt. Ich studiere in Kairo.</strong></p>\n        \n        <p>Letzten Monat wollte ich im Internet einen Artikel über Präsident Mubarak lesen. Die Seite war gesperrt. <strong>Ich kann nicht lesen, was ich will.</strong></p>\n        \n        <p>Mein Bruder Karim schrieb auf Facebook: „Wir brauchen Veränderung.\" Am nächsten Tag kam die Polizei. Sie nahmen ihn mit. <strong>Drei Tage war er weg. Als er zurückkam, hatte er blaue Flecken. Er weinte. Er sagte nichts mehr.</strong></p>\n        \n        <p>Meine Familie hat wenig Geld. Mein Vater ist krank. Wir brauchen einen Arzt. Aber der Arzt will Geld – extra Geld. Wir können nicht zahlen. <strong>Mein Vater bekommt keine Hilfe.</strong></p>\n        \n        <p>Präsident Mubarak regiert seit 30 Jahren. <strong>Wir dürfen nicht wählen. Wir dürfen nicht frei sprechen. Die Polizei macht, was sie will.</strong></p>\n        \n        <p>Im Januar 2011 gingen wir auf die Straße. Tausende Menschen auf dem Tahrir-Platz. <strong>Wir riefen: „Wir wollen Freiheit! Mubarak muss weg!\"</strong></p>\n        \n        <p><strong>Am 11. Februar trat Mubarak zurück. Ich weinte vor Freude. Jetzt wird alles besser!</strong></p>\n    </div>\n    \n    <!-- Aufgaben -->\n    <div class=\"tasks\">\n        <div class=\"task\">\n            <div class=\"task-title\">1. Wer spricht? Was macht die Person?</div>\n            <div class=\"answer-line\"></div>\n        </div>\n        \n        <div class=\"task\">\n            <div class=\"task-title\">2. Welche Gefühle hat Fatima? (Kreuze an)</div>\n            <div class=\"checkbox-options\">\n                <div class=\"checkbox-option\">\n                    <span class=\"checkbox\"></span>\n                    <span>Wütend</span>\n                </div>\n                <div class=\"checkbox-option\">\n                    <span class=\"checkbox\"></span>\n                    <span>Angst</span>\n                </div>\n                <div class=\"checkbox-option\">\n                    <span class=\"checkbox\"></span>\n                    <span>Hoffnung</span>\n                </div>\n                <div class=\"checkbox-option\">\n                    <span class=\"checkbox\"></span>\n                    <span>Freude</span>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"task\">\n            <div class=\"task-title\">3. Warum war Fatima unzufrieden? Nenne 3 Beispiele:</div>\n            <div class=\"answer-line-short\"></div>\n            <div class=\"answer-line-short\"></div>\n            <div class=\"answer-line-short\"></div>\n        </div>\n        \n        <div class=\"task\">\n            <div class=\"task-title\">4. Was haben die Menschen getan?</div>\n            <div class=\"answer-line\"></div>\n            <div class=\"answer-line\"></div>\n        </div>\n    </div>\n</body>\n</html>\n"}},"jsonrpc":"2.0","id":8} { metadata: undefined }
