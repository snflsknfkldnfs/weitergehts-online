from docx import Document
doc = Document('/sessions/laughing-great-fermi/mnt/<vol>/_artefakte-plugin-pilot/samples/plugin-output/KW18_v7/KW18_270426_Kinderarbeit_AB_n1.docx')
def alle_tabellen(t, lvl=0):
    yield t, lvl
    for row in t.rows:
        for cell in row.cells:
            for inner in cell.tables:
                yield from alle_tabellen(inner, lvl+1)

print('=== n1 alle Aufgaben (rekursiv) ===')
for tbl in doc.tables:
    for inner_tbl, lvl in alle_tabellen(tbl):
        if len(inner_tbl.rows) == 1 and len(inner_tbl.rows[0].cells) == 2:
            nr = inner_tbl.rows[0].cells[0].text.strip()
            imp = inner_tbl.rows[0].cells[1].text.strip()
            if nr.isdigit() and imp:
                print(f' Aufg {nr}: {imp[:160]}')
" as laughing-great-fermi
