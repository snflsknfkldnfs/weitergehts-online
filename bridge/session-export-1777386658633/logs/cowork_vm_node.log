import asyncio, sys
sys.path.insert(0, '.')
from pathlib import Path
from scripts.generate import baue_queries, cache_bilder, baue_ab_config, waehle_bild_fuer_niveau, waehle_teilziel_fuer_niveau
from scripts.ab_templates import aufgaben_n2
from lib.briefing import BriefingAggregator
from lib.cache import Cache
from scripts.sources.wikimedia import WikimediaAdapter
from scripts.sources.wikipedia import WikipediaAdapter
from scripts.validate_tuv import parse

async def main():
    tuv = parse(Path('/sessions/laughing-great-fermi/mnt/<vol>/05_Lernbereich_Recht/02_Kinderarbeit/KW18_270426_Kinderarbeit_TUV.md'))
    aggr = BriefingAggregator(adapter=[WikimediaAdapter(), WikipediaAdapter()], parallel_max=4)
    eintraege = await aggr.run(baue_queries(tuv))
    cache = Cache()
    await cache_bilder(eintraege, cache)
    bild = waehle_bild_fuer_niveau(eintraege, 'n2')
    print('bild:', bild)
    print('bild.bild_pfad:', bild.bild_pfad if bild else None)
    if bild and bild.bild_pfad:
        p = Path(bild.bild_pfad)
        print('  Path:', p)
        print('  exists:', p.exists())
        print('  size:', p.stat().st_size if p.exists() else 'N/A')
    teilziel = waehle_teilziel_fuer_niveau(tuv, 'n2')
    aufg = aufgaben_n2('Kinderarbeit', ['k'], None, bild.titel if bild else None, None)
    cfg = baue_ab_config(tuv, 'n2', teilziel, eintraege, bild, aufg)
    print('cfg.bild_pfad:', cfg.bild_pfad)
    print('  type:', type(cfg.bild_pfad))
    if cfg.bild_pfad:
        print('  cfg.bild_pfad.exists():', cfg.bild_pfad.exists())

asyncio.run(main())
