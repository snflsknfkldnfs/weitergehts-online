import sys, asyncio
sys.path.insert(0, '/sessions/laughing-great-fermi/mnt/<vol>/_artefakte-plugin-pilot/plugin-src')
from pathlib import Path
from scripts.generate import run, baue_queries, cache_bilder, waehle_bild_fuer_niveau
from lib.briefing import BriefingAggregator
from lib.cache import Cache
from scripts.sources.wikimedia import WikimediaAdapter
from scripts.sources.wikipedia import WikipediaAdapter
from scripts.validate_tuv import parse

async def main():
    tuv = parse(Path('/sessions/laughing-great-fermi/mnt/<vol>/05_Lernbereich_Recht/02_Kinderarbeit/KW18_270426_Kinderarbeit_TUV.md'))
    queries = baue_queries(tuv)
    print('Stichworte:', queries[0].stichworte)
    aggr = BriefingAggregator(adapter=[WikimediaAdapter(), WikipediaAdapter()], parallel_max=4)
    eintraege = await aggr.run(queries)
    bilder = [e for e in eintraege if e.typ == 'bild']
    print('Bilder vor cache:', len(bilder))
    for b in bilder[:3]:
        print(f'  {b.titel[:50]:50} | thumb_url: {(b.extra or {}).get(\"thumb_url\",\"?\")[:60]}')
    cache = Cache()
    pfade = await cache_bilder(eintraege, cache)
    print('Bilder nach cache:', len(pfade))
    for n in ['n1','n2','n3']:
        b = waehle_bild_fuer_niveau(eintraege, n)
        print(f'{n}: {b.titel[:40] if b else None} | bild_pfad={b.bild_pfad if b else None}')

asyncio.run(main())
