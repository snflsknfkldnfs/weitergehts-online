import json
import os
from collections import defaultdict, Counter

BASE = "scratch/archi-audit"
ras = {}
for n in range(1, 8):
    path = f"{BASE}/RA-P{n}-finding-report.json"
    with open(path) as f:
        ras[f"RA-P{n}"] = json.load(f)

print("=== Recommendations ===")
for k, v in ras.items():
    print(f"{k}: rec={v.get('recommendation')}  conf={v.get('confidence')}  findings={len(v.get('per_subagent_findings',[]))}")

print("\n=== Per-Subagent-Aggregation: Migration-Klassifikation ===")
# subagent_path → {ra_id: classification}
agg = defaultdict(dict)
for ra_id, rep in ras.items():
    for f in rep.get('per_subagent_findings', []):
        path = f.get('subagent_path', '').replace('agents/', '').replace('.md', '')
        cls = f.get('migration_classification', '?')
        agg[path][ra_id] = cls

# Konvergenz: in wievielen Faellen ist die Klassifikation konsistent (=Mehrheit)
print(f"\nTotal unique subagents touched: {len(agg)}")

for path in sorted(agg.keys()):
    classes = list(agg[path].values())
    counter = Counter(classes)
    most_common = counter.most_common(1)[0]
    convergence = "STARK" if most_common[1] >= 3 else ("MITTEL" if most_common[1] == 2 else "DIVERGENT")
    print(f"  {path:45s} | {len(classes)} RAs  | top={most_common[0]:25s} ({most_common[1]}x) | {convergence}")
