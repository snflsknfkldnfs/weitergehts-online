    print(f'Briefing-Eintraege: {len(entries)}')
    for e in entries[:6]:
        print(f'  [{e.typ}] {e.titel[:50]:50} | {e.lizenz} | {e.quelle}')

    out = Path('/tmp/test_briefing.yaml')
    write_briefing(entries, out, ue_id='KW18_test', tuv_pfad='KW18_270426_Kinderarbeit_TUV.md')
