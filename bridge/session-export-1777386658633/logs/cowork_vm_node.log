      echo "[YAML] $f | loc=$loc | name=$name | model=$model | tools=$tools"
    else
      header=$(head -1 "$f" | cut -c1-80)
      echo "[---] $f | loc=$loc | header=$header"
    fi
  fi
done as eloquent-pensive-pasteur
