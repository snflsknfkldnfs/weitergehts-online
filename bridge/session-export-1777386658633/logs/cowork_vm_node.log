python3 << 'PYEOF'
import json
from collections import defaultdict, Counter

BASE = "scratch/archi-audit"
ras = {}
for n in range(1, 8):
    path = f"{BASE}/RA-P{n}-finding-report.json"
    with open(path) as f:
        ras[f"RA-P{n}"] = json.load(f)

print("=== Hypothesen-Aggregation ===")
H_LABELS = ["H1_inkrementell", "H2_tiefe_refactor_single_system", "H3_scratch_mvp_neu_repo", "H4_hybrid_plugin_python_glue", "H5_parallel_coexistence_migration"]

for h in H_LABELS:
    print(f"\n--- {h} ---")
    feasibilities = []
    efforts = []
    for ra_id, rep in ras.items():
        he = rep.get('hypothesis_evaluation', {})
        # support different naming
        if h not in he:
            # try alternate keys
            alt = h.replace('_single_system','').replace('_neu_repo','').replace('_plugin_python_glue','').replace('_coexistence_migration','')
            if alt in he:
                hd = he[alt]
            else:
                # any matching prefix
                for k in he:
                    if k.startswith(h.split('_')[0]):
                        hd = he[k]
                        break
                else:
                    print(f"  {ra_id}: KEY MISSING ({h})")
                    continue
        else:
            hd = he[h]
        feas = hd.get('feasibility', '?')
        eff = hd.get('effort_weeks', '?')
        feasibilities.append(feas)
        efforts.append(eff)
        risks = hd.get('risks', [])
        risk_count = len(risks) if isinstance(risks, list) else 0
        print(f"  {ra_id}: feas={feas:8s} effort_weeks={str(eff):8s} risks={risk_count}")
    # Median + Modus
    cnt = Counter(feasibilities)
    print(f"  AGGREGAT: feas-Verteilung={dict(cnt)}")
    eff_numeric = [e for e in efforts if isinstance(e, (int, float))]
    if eff_numeric:
        eff_med = sorted(eff_numeric)[len(eff_numeric)//2]
        eff_min = min(eff_numeric)
        eff_max = max(eff_numeric)
        print(f"  AGGREGAT: effort_weeks median={eff_med}  min={eff_min}  max={eff_max}")

print("\n=== Recommendation-Voting (gewichtet nach Confidence) ===")
votes = defaultdict(float)
for ra_id, rep in ras.items():
    rec = rep.get('recommendation', '?')
    conf = rep.get('confidence', 0.5)
    votes[rec] += conf
    print(f"  {ra_id}: {rec} (conf={conf})")
print(f"\n  Gewichtete Stimmen: {dict(sorted(votes.items(), key=lambda x: -x[1]))}")

print("\n=== Architecture-Gaps (alle, dedup pending) ===")
gaps = []
for ra_id, rep in ras.items():
    for g in rep.get('architecture_gaps', []):
        gaps.append({'ra': ra_id, 'gap': g.get('gap', '?')[:80], 'sev': g.get('severity', '?')})

print(f"Total: {len(gaps)}")
for g in gaps:
    print(f"  [{g['sev']:6s}] {g['ra']}: {g['gap']}")
