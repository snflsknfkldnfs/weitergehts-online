import json
import difflib

with open('/sessions/eloquent-pensive-pasteur/scratch/c2/material.json') as f:
    m1 = json.load(f)
with open('/sessions/eloquent-pensive-pasteur/scratch/c2/material_v2.json') as f:
    m2 = json.load(f)

# Field-level diff
print("--- Field-level Changes ---")
for key in ['inhalt', 'quelle']:
    if m1[key] != m2[key]:
        print(f"CHANGED: {key}")
    else:
        print(f"UNCHANGED: {key}")

print("\n--- _meta Changes ---")
all_meta_keys = set(m1['_meta'].keys()) | set(m2['_meta'].keys())
for key in sorted(all_meta_keys):
    v1 = m1['_meta'].get(key, '<ABSENT>')
    v2 = m2['_meta'].get(key, '<ABSENT>')
    if v1 != v2:
        if v1 == '<ABSENT>':
            print(f"ADDED: _meta.{key} = {v2 if isinstance(v2, (str, int, float)) else '<complex>'}")
        elif v2 == '<ABSENT>':
            print(f"REMOVED: _meta.{key}")
        else:
            print(f"CHANGED: _meta.{key}")
    else:
        pass

# Inhalt diff (char-level)
print("\n--- Inhalt HTML Diff ---")
i1 = m1['inhalt']
i2 = m2['inhalt']
print(f"inhalt v1 length: {len(i1)}, v2 length: {len(i2)}")
# Word-level diff
words1 = i1.split()
words2 = i2.split()
matcher = difflib.SequenceMatcher(None, words1, words2)
changed_words = sum(max(i2-i1, j2-j1) for tag, i1, i2, j1, j2 in matcher.get_opcodes() if tag != 'equal')
total_words = max(len(words1), len(words2))
print(f"inhalt word-level: {total_words} words total, ~{changed_words} changed")
print(f"Similarity ratio: {matcher.ratio()*100:.1f}%")

# Identify specific changes via opcodes
print("\n--- Word-level Opcodes (non-equal) ---")
for tag, i1, i2, j1, j2 in matcher.get_opcodes():
    if tag != 'equal':
        v1_chunk = ' '.join(words1[i1:i2])[:80]
        v2_chunk = ' '.join(words2[j1:j2])[:80]
        print(f"  {tag}: [{v1_chunk}] → [{v2_chunk}]")

# Count findings adressiert
print("\n--- Diff-Ratio Analysis ---")
# FAIL findings in review_v1: 2 (SQ-2 Waterberg + Q10 Herero-Adressat)
# Both were on inhalt/einleitung/satz-2
# Revisor changes must be primarily in that location + triviale WARN-Adressierungen (Nation-als-solche + Impuls-3)

# Acceptable changes categorized
acceptable_change_locations = {
    "inhalt/einleitung/satz-2": ["FAIL SQ-2 Waterberg-Entfernung + FAIL Q10 Adressat-Korrektur"],
    "inhalt/erlaeuterung (Nation-als-solche)": ["WARN KONTEXT-DRIFT Nation-als-solche-Teilzitat entfernt"],
    "_meta.quellenkritische_impulse[2]": ["WARN QT-5 Herero-Perspektiv-Impuls ergaenzt"],
    "_meta.wortanzahl": ["Automatisch aktualisiert"],
    "_meta.review_iteration": ["Automatisch aktualisiert"],
    "_meta.review_warnings": ["Befuellt gemaess J.5"],
    "_meta.revisor_notes": ["Befuellt gemaess J.2 (optional)"]
}
print("Acceptable changes (per J.3 Edit-Granularitaets-Tabelle + J.6 auto-Updates):")
for loc, desc in acceptable_change_locations.items():
    print(f"  {loc}: {desc[0]}")
