site_name: Schulrecht-Lernscripts
site_description: 2. Staatsexamen Mittelschule Bayern — Mündliche Prüfung Schulrecht
site_url: https://weitergehts.online/staatsexamen/schulrecht/skripts/
site_author: Paul Cebulla
docs_dir: docs
site_dir: ../staatsexamen/schulrecht/skripts
use_directory_urls: true

theme:
  name: material
  language: de
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      primary: deep orange
      accent: deep orange
      toggle:
        icon: material/brightness-7
        name: Dunkelmodus
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      primary: deep orange
      accent: deep orange
      toggle:
        icon: material/brightness-4
        name: Hellmodus
  features:
    - navigation.instant
    - navigation.tracking
    - navigation.tabs
    - navigation.sections
    - navigation.indexes
    - navigation.top
    - navigation.footer
    - navigation.path
    - toc.follow
    - search.suggest
    - search.highlight
    - content.code.copy
    - content.tabs.link
    - content.tooltips
  font:
    text: Inter
    code: JetBrains Mono
  icon:
    repo: fontawesome/brands/github

extra_css:
  - stylesheets/extra.css

extra_javascript:
  - javascripts/extra.js

markdown_extensions:
  - abbr
  - admonition
  - attr_list
  - def_list
  - footnotes
  - md_in_html
  - tables
  - toc:
      permalink: "¶"
      toc_depth: 4
      title: "Auf dieser Seite"
      permalink_title: "Permalink zu dieser Sektion"
  - pymdownx.emoji:
      emoji_index: !!python/name:material.extensions.emoji.twemoji
      emoji_generator: !!python/name:material.extensions.emoji.to_svg
  - pymdownx.details
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.inlinehilite
  - pymdownx.snippets:
      base_path:
        - docs
        - docs/includes
      check_paths: true
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:mermaid2.fence_mermaid_custom
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.tasklist:
      custom_checkbox: true
  - pymdownx.tilde
  - pymdownx.caret
  - pymdownx.mark
  - pymdownx.keys

plugins:
  - search:
      lang: de
  - mermaid2:
      version: 10.9.1

hooks:
  - hooks.py

nav:
  - Übersicht: index.md
  - "MP_03 Gliederung Bildungssystem": mp03/index.md
  - "MP_05 Rechte und Pflichten Schüler:innen": mp05/index.md
  - "MP_06 Rechte und Pflichten Lehrkräfte": mp06/index.md
  - "MP_08 Kooperation Bildungsdienste": mp08/index.md

extra:
  generator: false
  social:
    - icon: fontawesome/brands/github
      link: https://github.com/snflsknfkldnfs/weitergehts-online
